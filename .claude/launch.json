{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "studio-harness",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8899",
        "--directory",
        "studio-extension"
      ],
      "port": 8899
    },
    {
      "name": "website",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "website",
        "exec",
        "--",
        "next",
        "start",
        "website",
        "-p",
        "3100"
      ],
      "port": 3100
    }
  ]
}
