node_modules/
dist/
.chrome-debug-profile/
*.js.map
dist.crx
dist.pem
dom-after-images.html
flow-dom.html
flow_page_with_all_media.html
page_with_videos.html
whenimageisaddtotheprompt.html
# Secrets — never commit .env files
.env
.env.*
*.env
.vercel

# Local-only skill wiring: .agents/skills is a junction to .agent/skills.
# Not a portable artifact, so keep it out of git.
.agents/
__pycache__/

# graphify knowledge-graph output — regenerable from source, ~8 MB
graphify-out/

# Packaged extension builds. Regenerated by `npm run build:publish` + zip, and
# they accumulate one ~350 KB copy per release, which is a lot of binary churn
# in a repo where the source it came from is already tracked.
extension/*.zip

# Local SQLite used by config.settings.local. Production is Postgres on
# Railway, so this is scratch data that differs per machine.
db.sqlite3

# Per-machine Claude Code permission overrides. launch.json IS tracked — it
# tells anyone how to start the website dev server — but settings.local.json
# is personal.
.claude/settings.local.json
