# ============================================================
# PromptExtractor — Backend Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# AI (use Vertex in production; AI Studio is a development fallback)
GEMINI_API_KEY=your-gemini-api-key
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GCP_CREDENTIALS_JSON=
GCS_BUCKET_NAME=autoflow-extractor-videos
CLIP_LOCATION=global
CLIP_MODEL=gemini-3.7-flash

# Auth — must match the Django SECRET_KEY used to sign SimpleJWT access tokens.
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256

# Django is the authoritative, atomic clipping quota service.
DJANGO_API_URL=https://api.auto-flow.studio/api
ENFORCE_EXTRACTION_LIMITS=true

# Shared job status (required in production so polling survives multiple workers).
REDIS_URL=redis://localhost:6379/0
JOB_STATE_TTL_SEC=86400
CLIP_JOB_STALE_SEC=1800
MAX_CONCURRENT_CLIP_JOBS=2

# Upload limits. The server probes the real duration; it does not trust the client.
MAX_VIDEO_SIZE_MB=500
MAX_VIDEO_DURATION_SEC=7200

# Stripe
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret
STRIPE_PRICE_ID_STARTER=price_starter
STRIPE_PRICE_ID_PRO=price_pro

# Frontend
FRONTEND_URL=http://localhost:3000
