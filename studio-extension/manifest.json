{
  "manifest_version": 3,
  "name": "AutoFlow Studio — Node Workflows for AI Video",
  "version": "0.13.0",
  "description": "Build node workflows that drive Google Veo, ChatGPT and Grok from one canvas. Third-party tool, not affiliated with Google, OpenAI or xAI.",
  "minimum_chrome_version": "114",
  "offline_enabled": false,
  "homepage_url": "https://auto-flow.studio",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "identity",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://api.auto-flow.studio/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AutoFlow Studio",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/flow*",
        "https://labs.google/fx*"
      ],
      "js": [
        "sw-bypass.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://labs.google/flow*",
        "https://labs.google/fx*"
      ],
      "js": [
        "flow-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "chatgpt-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "gemini-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "studio.html",
        "assets/*"
      ],
      "matches": [
        "https://labs.google/*",
        "https://chatgpt.com/*"
      ]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
